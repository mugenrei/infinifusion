bool invoke_owned_serial(void* function,void* array,std::int32_t index,std::int32_t* serial) noexcept {
    __try { *serial=reinterpret_cast<std::int32_t(__fastcall*)(void*,std::int32_t)>(function)(array,index); return true; }
    __except(EXCEPTION_EXECUTE_HANDLER) { return false; }
}
bool certify_owned_object_serial(Runtime& runtime,void* object) {
    std::array<std::uint8_t,kOwnedSerialCode.size()> live{};
    if(runtime.exe_timestamp!=kKnownExeTimestamp || runtime.image_size!=kKnownImageSize ||
       !safe_copy(runtime.image_base+0x10A4B70,live.data(),live.size()) || live!=kOwnedSerialCode) return false;
    NativeObjectDiscovery discovery(runtime);
    const auto before=discovery.certify(object);
    if(!before) return false;
    if(before->serial>0) return true;

    auto* array=reinterpret_cast<void*>(reinterpret_cast<std::uintptr_t>(runtime.object_array)-0x10);
    const auto master=safe_read_at<std::int32_t>(array,0xB8);
    if(!master || *master<1000 || *master==INT32_MAX) return false;
    std::int32_t serial{};
    if(!invoke_owned_serial(runtime.image_base+0x10A4B70,array,before->index,&serial)) {
        log_line("ERROR","engine serial admission fault; no registry write/retry"); return false;
    }
    const auto after=discovery.certify(object,true);
    return after && serial>1000 && after->index==before->index &&
        after->klass==before->klass && after->serial==serial;
}
